[ -> 
    [loadm "scripts/conslib.mos" "cons"]

    is := [tag pair ->
        [cons_at 0 pair] = tag
    ]

    tag := [tag value -> 
        {tag value}
    ]

    untag := [tag pair -> 
        if [is tag pair] then [cons_at 1 pair] else {:invalidTagError "Invalid Tag"}
    ]

    {
        {"is" is}
        {"tag" tag}
        {"untag" untag}
    }
]