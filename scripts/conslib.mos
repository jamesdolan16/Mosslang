/**
 *  (Cons)truction (Lib)rary
 *
 *  Provides useful functions for handling constructions
 *
 *  @author James Dolan
*/
[ ->
    /**
    *  Fetches element at index in collection
    *
    *  If index exceeds the length of collection then :null is returned
    *
    *  @param integer index
    *  @param construction collection
    *  @return any
    */
    at := [index collection -> 
        if !(?collection = :construction) then 
            { :typeError { "Expected value of type construction, found " collection }}
        else 
            collection ~> :null [a e i -> 
                if i = index then { :reduced e } else a
            ]
    ]

    get := [key collection ->
        collection ~> :null [a e -> 
            thisKey := [at 0 e]
            thisVal := [at 1 e]
            if thisKey = key then { :reduced thisVal } else a
        ]
    ]

    /**
    * Reverses the order of collection
    *
    * @param construction collection
    * @return construction
    */
    reverse := [collection ->
        collection ~> {} [a e -> e|a]
    ]

    /**
    * Destructure collection into head and tail
    *
    * @param construction collection
    * @return construction{any, construction}
    */
    hat := [collection ->
        head := [at 0 collection]
        tail := collection ~> {} [a e i -> if i = 0 then a else a|e]
        {head tail}
    ]

    /**
    * Pop the last element off the construction
    *
    * @param construction collection
    * @return construction{construction, any}
    */ 
    pop := [collection -> 
        reversed := [reverse collection]
        ht := [hat reversed]
        {[at 0 ht] [reverse [at 1 ht]]}
    ]

    {
        {"at" at}
        {"get" get}
        {"reverse" reverse}
        {"hat" hat}
        {"pop" pop}
    }
]